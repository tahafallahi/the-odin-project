generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String  
  expiresAt   DateTime
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  hashed_password String
  folders Folder[]
  files File[]

  @@index([username])
}

model Folder {
  id Int @id @default(autoincrement())
  name String

  owner User @relation(fields: [owner_id], references: [id])
  owner_id Int

 
  children Folder[] @relation(name: "FolderToFolder")
  parent Folder? @relation(name: "FolderToFolder",fields: [parent_id], references: [id])
  parent_id Int?

  files File[]

  @@unique([parent_id, name])
}

model File {
  id Int @id @default(autoincrement())
  name String
  createAt DateTime @default(now())
  mimetype String?
  size Int
  storageKey String

  owner User @relation(fields: [owner_id], references: [id])
  owner_id Int

  folder Folder? @relation(fields: [folder_id], references: [id])
  folder_id Int?

  @@unique([folder_id, name])

}

