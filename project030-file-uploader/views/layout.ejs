<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="/auth.js" defer></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="/style.css" />
    <title>Filer.io</title>
  </head>
  <body>
    <header>
      <h1><a href="/root">Filer.io</a></h1>
      <% if (user) { %>
        <div class="nav" >
          <h2><%= user.username %></h2>
          <h2><a href="logout" class="<%- selected == 'logout'? 'selected': '' %>">Log Out</a></h2>
        </div>
        <% } else { %>
          <div class="nav">
            <h2>
              <a
              href="register"
            class="<%- selected == 'register'? 'selected': '' %>"
            >Sign In</a
            >
          </h2>
          <h2>
            <a href="login" class="<%- selected == 'login'? 'selected': '' %>"
              >Login</a
              >
            </h2>
          </div>
        <% } %>
      </header>
      <main>
        <%- body %>
      </main>
      
  </body>
  <script defer>lucide.createIcons();</script>
</html>
