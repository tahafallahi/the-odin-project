<!DOCTYPE html>
<html lang="en">
  <%- include("header") %>
  <body>
    <h2>Update Item</h2>
    <form method="POST" action="">
      <div>
        <label for="name">Item Name</label>
        <input type="text" id="name" name="name" value="<%= item.name %>" required/>
      </div>
        <label for="category">Item Category</label>
        <input type="" id="category" name="category" list="category-options" value="<%= item.category_name %>"/>
        <datalist id="category-options">
            <% categoires.map(category => { %>
                <option value="<%= category.name %>"></option>
            <% }) %> 
        </datalist>
      </div>
      <div>
        <label for="stock">In Stock</label>
        <input onfocus="this.select();" type="number" id="stock" name="stock" value="<%= item.stock %>"/>
      </div>
        <label for="price">Price</label>
        <input onfocus="this.select();" type="number" id="price" name="price"  value="<%= item.price %>"/>
      </div>
      <button type="submit">Update</button>
    </form>
  </body>
</html>
