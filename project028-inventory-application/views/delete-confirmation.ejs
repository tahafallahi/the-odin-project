<!DOCTYPE html>
<html lang="en">
  <%- include("header") %>
  <body>
    <h2>Are you sure you want to delete this item?</h2>
    <ul class="items-list">
      <li>
        <p><%= item.id %></p>
        <h3><%= item.name %></h3>
        <p><%= item.category_name %></p>
        <p><%= item.stock %></p>
        <p><%= item.price %> $</p>
        <form method="POST" action="">
          <input type="hidden" value="<%= item.id %>" name="id" />
          <button type="submit">Remove</button>
        </form>
        <a href="/item">Go Back To Item List</a>
      </li>
    </ul>
  </body>
</html>
